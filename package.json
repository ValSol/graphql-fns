{
  "name": "graphql-fns",
  "version": "0.1.2-beta.1141",
  "description": "Useful functions to work with graphql",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./client": {
      "require": "./dist/client/index.cjs",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "tsup",
    "prepack": "yarn build",
    "commit": "git-cz",
    "test:once": "jest --config=\"./configs/jest.config.js\" --runInBand --verbose false",
    "test:mongodb": "NODE_OPTIONS=--experimental-vm-modules jest --config=\"./configs/jest.config.mongodb.js\" --runInBand --verbose false --detectOpenHandles",
    "test": "jest  --config=\"./configs/jest.config.js\" --watch",
    "semantic-release": "semantic-release",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValSol/graphql-fns.git"
  },
  "keywords": [
    "graphql",
    "utils"
  ],
  "author": "Valentyn Soloviov <v.solovyov@intellect.ua>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ValSol/graphql-fns/issues"
  },
  "homepage": "https://github.com/ValSol/graphql-fns#readme",
  "dependencies": {
    "@turf/buffer": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "deep-object-diff": "^1.1.9",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-scalars": "^2.0.0",
    "lodash.merge": "^4.6.2",
    "mingo": "^7.2.4",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.1.1",
    "@graphql-yoga/subscription": "^5.1.0",
    "@shelf/jest-mongodb": "^6.0.2",
    "@swc/core": "^1.16.2",
    "@types/jest": "^30.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.0",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "fast-deep-equal": "^3.1.3",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "mkdirp": "^3.0.1",
    "mongoose": "^9.10.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "@graphql-yoga/subscription": "5.x",
    "@swc/core": "^1.x",
    "fast-deep-equal": "3.x",
    "graphql": "17.x",
    "mongoose": "9.x"
  },
  "resolutions": {
    "tar": "7.5.22",
    "pacote": "21.5.1",
    "@babel/core": "7.29.7",
    "browserslist": "4.29.0",
    "ajv@npm:^8.11.0": "8.20.0",
    "fast-uri": "3.1.8",
    "brace-expansion@npm:^1.1.7": "1.1.21",
    "brace-expansion@npm:^2.0.1": "2.1.7",
    "@sigstore/core": "3.2.1",
    "@sigstore/verify": "3.1.1",
    "sigstore": "4.1.1",
    "@ungap/structured-clone": "1.3.1",
    "@humanfs/node": "0.16.8",
    "lodash-es": "4.18.1",
    "yauzl": "3.2.1",
    "follow-redirects": "1.16.0",
    "postcss-selector-parser": "7.1.3",
    "esbuild": "0.28.1",
    "rollup": "4.63.3",
    "js-yaml@npm:^3.13.1": "3.15.2",
    "js-yaml@npm:^4.1.0": "4.3.2",
    "ip-address": "10.7.2",
    "picomatch@npm:^2.3.1": "2.3.2",
    "picomatch@npm:^2.0.4": "2.3.2",
    "minimatch@npm:^3.1.1": "3.1.5",
    "minimatch@npm:^9.0.4": "9.0.9",
    "undici@npm:^6.23.0": "6.28.1",
    "undici@npm:^7.0.0": "7.29.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    },
    "ghooks": {
      "pre-commit": "yarn test:once"
    }
  },
  "packageManager": "yarn@4.9.2"
}
